[Unit]
Description=Antivirus-Immunity eBPF node agent
Documentation=https://github.com/KingDragon-yc/Antivirus-Immunity
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/immunity
Environment=IMMUNITY_INTERFACE=eth0
EnvironmentFile=-/etc/immunity/immunity.env
ExecStart=/usr/local/bin/immunity-ebpf --mode monitor --profile server --ai false --interface ${IMMUNITY_INTERFACE} --metrics-listen 127.0.0.1:9090 --kernel-policy /etc/immunity/kernel-policy.json --threat-intel /etc/immunity/threat-intel.json
ExecStopPost=-/sbin/tc filter del dev ${IMMUNITY_INTERFACE} egress pref 1 handle 1 bpf
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
LimitMEMLOCK=infinity
NoNewPrivileges=true
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_KILL
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_KILL
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/immunity

[Install]
WantedBy=multi-user.target
